+    output[len] = 0;
+    close(xkbcomp_output_fd);
+    xkbcomp_output_fd = -1;
+
+    if (failed)
+        fputs(output, stderr);
+    else
+        for (char *line = strtok(output, "\n"); line; line = strtok(NULL, "\n"))
+            __android_log_write(ANDROID_LOG_DEBUG, "xkbcomp", line);
+}
