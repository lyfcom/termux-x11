+    static char output[65536];
+    int cap = sizeof(output) - 1, len = 0, r;
+
+    if (xkbcomp_output_fd < 0)
+        return;
+
+    while (len < cap && (r = read(xkbcomp_output_fd, output + len, cap - len)) > 0)
